{
  "name": "dataijam",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web para la gestión del evento DatAIJam",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "pnpm --filter @dataijam/web dev",
    "build": "pnpm --filter @dataijam/web build",
    "lint": "pnpm --filter @dataijam/web lint",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6"
  }
}
